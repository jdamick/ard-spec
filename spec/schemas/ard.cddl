; CDDL Specification for Agentic Resource Discovery (ARD entry, manifest & Registry schemas)
; Compliant with IETF RFC 8610 (Concise Data Definition Language)
;
; This file restates spec/schemas/ard-entry.schema.json (entries and the manifest)
; and spec/schemas/ard.openapi.yaml (the registry API payloads) for CBOR/CDDL
; consumers. Where they disagree, the JSON Schema and the OpenAPI document are
; authoritative.
;
; Keys that are also names in the RFC 8610 prelude ("text", "uri") are quoted, so
; no tool can read them as a type and match any key. The prelude's `any` and
; `null` are used as defined there and are not redefined.

start = ard-manifest

; --- The Manifest ---
; ARD requires only an `entries` array. Any other top-level member is
; transport-defined and ignored by ARD, hence the trailing wildcard.

ard-manifest = {
  entries: [* ard-entry],
  * tstr => any
}

; --- The ARD entry ---
; The unit ARD is defined over. Every ARD entry is a well-formed catalog entry;
; not every catalog entry is an ARD entry.

ard-entry = {
  ard-entry-required,
  content-delivery, ; strict value-or-reference
  ard-entry-descriptive,
  * tstr => any     ; terms from namespaces declared in @context remain valid
}

; The url/data choice sits at map level, as AI Catalog's CatalogEntry has it.
; Nested inside ard-entry-required it is valid CDDL that the reference cddl tool
; cannot process. The trailing wildcard also matches the other member, so this
; grammar admits an entry with both; the JSON Schema and §4.3 reject it.

ard-entry-required = (
  identifier: urn-air,
  displayName: tstr,
  type: tstr        ; IANA Media Type (e.g. application/mcp-server-card+json)
)

; urn:air:<publisher>:<name>[:<kind>] (Appendix C), the same pattern as the
; JSON Schema. RFC 8610 .regexp uses XSD regular expressions, which match the
; whole string.
urn-air = tstr .regexp "urn:air:[a-zA-Z0-9.\\-]+:([a-zA-Z0-9._~!$&'()*+,;=@/\\-]|%[0-9a-fA-F]{2})+(:([a-zA-Z0-9._~!$&'()*+,;=@/\\-]|%[0-9a-fA-F]{2})+)?"

ard-entry-descriptive = (
  ? "@context" ^ => json-ld-context, ; cut, so the wildcard can't take a bad value
  ? "@id" ^ => tstr,
  ? description: tstr,
  ? tags: [* tstr],
  ? capabilities: [* tstr],
  ? representativeQueries: [* tstr], ; RECOMMENDED; conformance tester warns if absent or count is not 2-5
  ? version: tstr,
  ? updatedAt: tstr, ; ISO 8601 timestamp
  ? metadata: {* tstr => (tstr / int / float / bool / null)},
  ? trustManifest: trust-manifest
)

content-delivery = (
  url: tstr //
  data: {* tstr => any}
)

json-ld-context = tstr / {* tstr => any} / [* any]

; --- The Zero-Trust / Compliance Envelope ---
; ARD requires only `identity`. The envelope is framework-defined and open:
; a registry is expected to verify it per the framework named in trustSchema.

trust-manifest = {
  identity: tstr, ; SPIFFE, DID, or FQDN URI
  ? identityType: tstr, ; hint, e.g. "spiffe" / "did" / "https"
  ? trustSchema: trust-schema,
  ? attestations: [* attestation],
  ? provenance: [* provenance-link],
  ? signature: tstr,
  * tstr => any
}

trust-schema = {
  ? identifier: tstr,
  ? version: tstr,
  ? governanceUri: tstr,
  ? verificationMethods: [* tstr],
  * tstr => any
}

attestation = {
  type: tstr,
  "uri": tstr,
  ? mediaType: tstr,
  ? digest: tstr,
  * tstr => any
}

provenance-link = {
  relation: tstr, ; e.g. "derivedFrom" / "publishedFrom" / "copiedFrom"
  sourceId: tstr,
  ? sourceDigest: tstr,
  * tstr => any
}

; --- The Search and Explore Registry API Payloads ---

; Both endpoints take the same query object (§5.3.1); Search requires text.

query-model = {
  ? "@context" => json-ld-context,
  ? "text": tstr,
  ? filter: query-filter
}

search-query-model = {
  ? "@context" => json-ld-context,
  "text": tstr,
  ? filter: query-filter
}

query-filter = {* tstr => ([+ tstr] / tstr)}

search-request = {
  query: search-query-model,
  ? federation: "auto" / "referrals" / "none",
  ? pageSize: uint .le 100, ; default 10 (§5.3.2)
  ? pageToken: tstr
}

explore-request = {
  ? query: query-model,
  resultType: {
    facets: [+ explore-facet-request]
  }
}

explore-facet-request = {
  field: tstr,
  ? limit: uint,
  ? minCount: uint
}

explore-response = {
  resultType: "facets",
  facets: {* tstr => explore-facet-result}
}

explore-facet-result = {
  buckets: [* explore-facet-bucket],
  ? otherCount: uint
}

explore-facet-bucket = {
  value: tstr,
  ? count: uint ; SHOULD; a registry MAY omit it (§5.3.3)
}

search-response = {
  results: [* search-result-item],
  ? referrals: [* registry-referral],
  ? pageToken: tstr
}

search-result-item = {
  result-entry-fields,
  score: 0..100, ; Semantic relevance score
  source: tstr,  ; Registry base URL
  * tstr => any
}

result-entry = { result-entry-fields, * tstr => any }

result-entry-fields = (
  identifier: tstr,
  ? displayName: tstr,
  ? type: tstr,
  ? url: tstr,
  ? data: {* tstr => any},
  ard-entry-descriptive
)

registry-referral = {
  identifier: tstr,
  displayName: tstr,
  type: "application/ai-registry" / "application/ai-registry+json",
  url: tstr,
  * tstr => any
}

; In search and list results a registry returns the terms useful for selecting
; among results and MAY omit any other; only `identifier` is required.

list-response = {
  items: [* result-entry],
  ? total: uint,
  ? pageToken: tstr
}

error-response = {
  errorCode: tstr,
  message: tstr
}
